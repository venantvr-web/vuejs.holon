{
  "name": "holon-architecture-modeler",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "d3-force": "^3.0.0",
    "d3-hierarchy": "^3.1.2",
    "dexie": "^3.2.2",
    "fuse.js": "^7.3.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-vue-next": "^1.0.0",
    "nanoid": "^5.1.6",
    "pinia": "^2.0.14",
    "use-dexie": "^1.0.7",
    "vue": "^3.2.47",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/d3-force": "^3.0.10",
    "@types/d3-hierarchy": "^3.1.7",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "^4.1.8",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.14",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "^17.6.0",
    "happy-dom": "^20.3.7",
    "postcss": "^8.4.21",
    "prettier": "^3.8.4",
    "tailwindcss": "^3.3.1",
    "typedoc": "^0.28.19",
    "typescript": "^5.0.2",
    "typescript-eslint": "^8.61.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.8",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^3.3.4"
  }
}
