{
  // Configuration Cloudflare Workers (Static Assets).
  // Holon est une SPA Vue ; aucun Worker côté serveur n'est nécessaire,
  // on ne déploie que le bundle statique produit par `vite build` dans `./dist`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vuejs-holon",
  "compatibility_date": "2026-06-12",
  // Logs et métriques d'exécution visibles dans le dashboard Cloudflare
  // (repris de la branche cloudflare/workers-autoconfig).
  "observability": {
    "enabled": true,
  },
  "assets": {
    "directory": "./dist",
    // SPA : toute requête qui ne matche pas un fichier statique est rejouée
    // vers index.html pour laisser le routeur côté client gérer l'URL.
    "not_found_handling": "single-page-application",
  },
}
